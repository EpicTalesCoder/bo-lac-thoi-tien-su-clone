cmake_minimum_required(VERSION 3.16)
project(j2me_desktop_port LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

if(APPLE)
    list(APPEND CMAKE_PREFIX_PATH "/opt/homebrew" "/usr/local")
endif()

find_package(SDL2 REQUIRED)
find_package(SDL2_image REQUIRED)
find_package(SDL2_mixer REQUIRED)
find_package(SDL2_ttf REQUIRED)

file(GLOB_RECURSE PORT_SOURCES CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_SOURCE_DIR}/src/*.cpp"
)

add_executable(j2me_game ${PORT_SOURCES})

target_include_directories(j2me_game PRIVATE
    "${CMAKE_CURRENT_SOURCE_DIR}/src"
)

target_compile_definitions(j2me_game PRIVATE
    PORT_ASSETS_FALLBACK_DIR="${CMAKE_CURRENT_SOURCE_DIR}/assets"
)

target_compile_options(j2me_game PRIVATE
    -Wall -Wextra -Wno-unused-parameter -fno-rtti -fno-exceptions -O2
)

if(TARGET SDL2::SDL2)
    target_link_libraries(j2me_game PRIVATE SDL2::SDL2)
else()
    target_include_directories(j2me_game PRIVATE ${SDL2_INCLUDE_DIRS})
    target_link_libraries(j2me_game PRIVATE ${SDL2_LIBRARIES})
endif()

if(TARGET SDL2_image::SDL2_image)
    target_link_libraries(j2me_game PRIVATE SDL2_image::SDL2_image)
else()
    target_link_libraries(j2me_game PRIVATE SDL2_image)
endif()

if(TARGET SDL2_mixer::SDL2_mixer)
    target_link_libraries(j2me_game PRIVATE SDL2_mixer::SDL2_mixer)
else()
    target_link_libraries(j2me_game PRIVATE SDL2_mixer)
endif()

if(TARGET SDL2_ttf::SDL2_ttf)
    target_link_libraries(j2me_game PRIVATE SDL2_ttf::SDL2_ttf)
else()
    target_link_libraries(j2me_game PRIVATE SDL2_ttf)
endif()
